---
// 团队标志：四类应用场景（四个彩色节点）环绕一个 AI 核心（四角星）
interface Props { size?: number; class?: string }
const { size = 32, class: cls = '' } = Astro.props;
const uid = 'lg' + Math.random().toString(36).slice(2, 7);
---
<svg class={cls} width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="ougz 人工智能工作室">
  <defs>
    <linearGradient id={`${uid}-bg`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1d4596" /><stop offset="1" stop-color="#10245e" /></linearGradient>
    <linearGradient id={`${uid}-star`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#cfe6fb" /></linearGradient>
  </defs>
  <rect width="64" height="64" rx="15" fill={`url(#${uid}-bg)`} />
  <circle cx="32" cy="32" r="19" fill="none" stroke="#ffffff" stroke-opacity=".22" stroke-width="1.5" />
  <circle cx="18.6" cy="18.6" r="4.3" fill="#6ea6ff" />
  <circle cx="45.4" cy="18.6" r="4.3" fill="#f0a568" />
  <circle cx="45.4" cy="45.4" r="4.3" fill="#4fd1c5" />
  <circle cx="18.6" cy="45.4" r="4.3" fill="#5cc1f2" />
  <path d="M32 17.5C33.6 27 37 30.4 46.5 32C37 33.6 33.6 37 32 46.5C30.4 37 27 33.6 17.5 32C27 30.4 30.4 27 32 17.5Z" fill={`url(#${uid}-star)`} />
</svg>
